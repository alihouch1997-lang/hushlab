# Copiez ce fichier en .env et remplissez-le, ou exportez ces variables
# dans votre shell avant de lancer le site. Ne versionnez jamais le vrai .env.

# Signature des jetons CSRF. Générez-la une fois :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HUSHLAB_SECRET_KEY=

# Mot de passe de l'écran /admin. Vide = administration fermée.
HUSHLAB_ADMIN_MOTDEPASSE=

# Débogueur Werkzeug : 1 uniquement en développement, JAMAIS en production
# (il permet d'exécuter du code arbitraire sur le serveur).
HUSHLAB_DEBUG=0

# Le site est-il servi en HTTPS ? Conditionne le cookie sécurisé et HSTS.
HUSHLAB_HTTPS=1

# Notification email des nouvelles demandes (facultatif).
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_DESTINATAIRE=
